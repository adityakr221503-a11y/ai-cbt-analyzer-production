name: Cleanup rank-booster
on: workflow_dispatch
permissions:
  contents: write
jobs:
  clean:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Remove stray copies
        run: |
          cd rank-booster
          rm -f ai-question-lab.html analysis.html attempt.html biology-7196-cbt.html \
            biology-cbt-live.html biology-dual-system.html biology-mistake-retry.html cbt.html \
            command-center.html history.html index.html mastered.html mistake.html \
            orbit-test-analysis.html owner-access.html pdf-to-cbt.html pdf.html question-bank.html \
            ranker-command-center.html rankforge-bank-audit.html rankforge-master-pool-v2-audit.html \
            rankforge-owner-ai.html rankforge-source-importer.html rankforge-system-check.html \
            retry.html tag-practice.html test-details.html sw.js rankforge-premium.css \
            pdf-cbt-production-engine-v8.js pdf-cbt-universal-v1.js rankforge-canonical-v1.js \
            rankforge-core-v1.js rankforge-pdf-result-mastery-bridge-v1.js \
            rankforge-result-mistake-engine-v1.js
          cd ..
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add -A
          git commit -m "Remove stray copies from rank-booster" || echo "Nothing to remove"
          git push
